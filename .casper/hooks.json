{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "casper-project-context",
            "command": ["python3", "scripts/casper_project_hook.py"],
            "timeout": 5,
            "priority": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(make_directory|run_command)$",
        "hooks": [
          {
            "type": "command",
            "name": "casper-protected-path-guard",
            "command": ["python3", "scripts/casper_project_hook.py"],
            "timeout": 5,
            "priority": 10
          }
        ]
      }
    ]
  }
}
