{
  "dashboard": {
    "id": null,
    "title": "CASPER Prime Terminal Dashboard",
    "description": "Monitoring dashboard for CASPER Prime terminal system",
    "tags": ["casper", "terminal", "websocket"],
    "timezone": "browser",
    "refresh": "5s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Active Terminal Sessions",
        "type": "stat",
        "targets": [
          {
            "expr": "casper_terminal_active_sessions_total",
            "legendFormat": "Active Sessions"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "displayMode": "basic"
            },
            "unit": "short"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "WebSocket Connections",
        "type": "stat",
        "targets": [
          {
            "expr": "casper_websocket_connections_total",
            "legendFormat": "Total Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Command Execution Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(casper_terminal_commands_executed_total[5m]) * 60",
            "legendFormat": "Commands/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "cpm"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "colorMode": "value",
          "graphMode": "area"
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "Average Command Execution Time",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(casper_terminal_command_duration_seconds)",
            "legendFormat": "Avg Duration"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "s"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "colorMode": "value",
          "graphMode": "area"
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 18,
          "y": 0
        }
      },
      {
        "id": 5,
        "title": "Terminal Session Activity",
        "type": "timeseries",
        "targets": [
          {
            "expr": "casper_terminal_active_sessions_total",
            "legendFormat": "Active Sessions"
          },
          {
            "expr": "rate(casper_terminal_sessions_created_total[5m]) * 60",
            "legendFormat": "New Sessions/min"
          },
          {
            "expr": "rate(casper_terminal_sessions_closed_total[5m]) * 60",
            "legendFormat": "Closed Sessions/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            },
            "unit": "short"
          }
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "calcs": ["lastNotNull", "max", "min"]
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 6
        }
      },
      {
        "id": 6,
        "title": "Command Execution Performance",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(casper_terminal_command_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile"
          },
          {
            "expr": "histogram_quantile(0.90, rate(casper_terminal_command_duration_seconds_bucket[5m]))",
            "legendFormat": "90th percentile"
          },
          {
            "expr": "histogram_quantile(0.99, rate(casper_terminal_command_duration_seconds_bucket[5m]))",
            "legendFormat": "99th percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 10
            },
            "unit": "s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 6
        }
      },
      {
        "id": 7,
        "title": "WebSocket Message Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(casper_websocket_messages_sent_total[5m]) * 60",
            "legendFormat": "Messages Sent/min"
          },
          {
            "expr": "rate(casper_websocket_messages_received_total[5m]) * 60",
            "legendFormat": "Messages Received/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "cpm"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 14
        }
      },
      {
        "id": 8,
        "title": "Memory Usage by Terminal Sessions",
        "type": "timeseries",
        "targets": [
          {
            "expr": "casper_terminal_memory_usage_bytes",
            "legendFormat": "Memory Usage"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "bytes"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 14
        }
      },
      {
        "id": 9,
        "title": "Error Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(casper_terminal_command_errors_total[5m]) * 60",
            "legendFormat": "Command Errors/min"
          },
          {
            "expr": "rate(casper_websocket_errors_total[5m]) * 60",
            "legendFormat": "WebSocket Errors/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "cpm"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 22
        }
      },
      {
        "id": 10,
        "title": "Recent Terminal Commands",
        "type": "logs",
        "targets": [
          {
            "expr": "{job=\"casper-prime\"} |= \"terminal_command\"",
            "legendFormat": ""
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": false,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 30
        }
      }
    ],
    "links": [
      {
        "title": "CASPER Terminal User Guide",
        "url": "/docs/terminal-user-guide",
        "type": "link"
      },
      {
        "title": "API Documentation",
        "url": "/api/docs",
        "type": "link"
      }
    ],
    "templating": {
      "list": [
        {
          "name": "interval",
          "type": "interval",
          "query": "5s,10s,30s,1m,5m,15m,30m,1h",
          "current": {
            "value": "5s",
            "text": "5s"
          },
          "options": [
            {"value": "5s", "text": "5s"},
            {"value": "10s", "text": "10s"},
            {"value": "30s", "text": "30s"},
            {"value": "1m", "text": "1m"},
            {"value": "5m", "text": "5m"},
            {"value": "15m", "text": "15m"},
            {"value": "30m", "text": "30m"},
            {"value": "1h", "text": "1h"}
          ],
          "auto": true,
          "auto_count": 30,
          "auto_min": "10s"
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "increase(casper_deployment_timestamp[1m])",
          "iconColor": "green",
          "type": "builtin"
        }
      ]
    }
  },
  "overwrite": true
}